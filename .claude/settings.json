{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(npm run lint*)",
      "Bash(npm run build*)",
      "Bash(npm test*)",
      "Bash(npm run test*)",
      "Bash(npx tsc --noEmit*)",
      "Bash(npx eslint:*)",
      "Bash(git check-ignore:*)",
      "WebFetch(domain:github.com)"
    ],
    "deny": [
      "Read(./.env)",
      "Read(./.env.local)",
      "Read(./.env.production)",
      "Read(./user-passwords-*)",
      "Read(./node_modules/**)",
      "Read(./dist/**)",
      "Read(./package-lock.json)"
    ]
  }
}
