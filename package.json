{
  "name": "peskas-management-platform",
  "private": true,
  "version": "2.8.0",
  "type": "module",
  "scripts": {
    "dev:frontend": "vite",
    "dev:backend": "node server/dev.js",
    "dev": "concurrently \"npm run dev:frontend\" \"npm run dev:backend\"",
    "server": "node server/dev.js",
    "build": "tsc && vite build",
    "lint": "tsc --noEmit && tsc -p tsconfig.backend.json && eslint . --report-unused-disable-directives --max-warnings 0",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write \"{src,api,lib,server,scripts}/**/*.{ts,tsx,js,cjs,jsx,json,css}\"",
    "format:check": "prettier --check \"{src,api,lib,server,scripts}/**/*.{ts,tsx,js,cjs,jsx,json,css}\"",
    "preview": "vite preview",
    "render:lessons": "quarto render data-explorer",
    "sync:all": "node scripts/sync_all_from_airtable.js",
    "sync:countries": "node scripts/sync_countries_from_airtable.cjs",
    "sync:users": "node scripts/sync_users_from_airtable.js",
    "sync:surveys": "node scripts/sync_surveys_from_airtable.js",
    "sync:districts": "node scripts/sync_districts_from_airtable.cjs",
    "sync:taxa": "node scripts/sync_taxa_from_airtable.cjs",
    "ensure:indexes": "node scripts/ensure_survey_indexes.cjs",
    "test": "tsx src/utils/countryMetadata.test.ts && tsx src/utils/taxon.test.ts && node lib/submissions-query.test.js && node scripts/sync_taxa_from_airtable.test.cjs"
  },
  "dependencies": {
    "@aws-sdk/client-ses": "^3.972.0",
    "@tabler/core": "^1.4.0",
    "@tabler/icons-react": "^3.30.0",
    "@tanstack/react-table": "^8.10.7",
    "axios": "^1.6.2",
    "bcryptjs": "^3.0.2",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^5.2.1",
    "highcharts": "^12.2.0",
    "highcharts-react-official": "^3.2.1",
    "i18next": "^23.16.8",
    "i18next-browser-languagedetector": "^7.2.2",
    "i18next-http-backend": "^3.0.2",
    "jsonwebtoken": "^9.0.2",
    "mongodb": "^6.13.1",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-i18next": "^14.1.3",
    "react-router-dom": "^7.5.2"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/node": "^22.13.5",
    "@types/react": "^18.2.15",
    "@types/react-dom": "^18.2.7",
    "@typescript-eslint/eslint-plugin": "^8.67.0",
    "@typescript-eslint/parser": "^8.67.0",
    "@vitejs/plugin-react": "^4.0.3",
    "concurrently": "^8.2.2",
    "eslint": "^9.39.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.5.4",
    "globals": "^17.11.0",
    "prettier": "^3.6.2",
    "tsx": "^4.23.12",
    "typescript": "^5.0.2",
    "typescript-eslint": "^8.67.0",
    "vite": "^6.4.3"
  }
}
